[importlinter]
root_packages =
    engine

# Rule 4 (CLAUDE.md): configuration governs behaviour; nothing learns at
# runtime. The config writer performs an administrative publish and must be
# unreachable from anything that runs on a case (the API today; the
# pipeline, rule engine, review and copilot as they land in later stages).
[importlinter:contract:1]
name = Runtime code must not import the config writer
type = forbidden
source_modules =
    engine.api
    engine.auth
    engine.store
    engine.checklist
    engine.samplegen
forbidden_modules =
    engine.configstore.writer
