# Ingestion engine — ready for Docker. Copy to .env and set AI_API_KEY; nothing else needs to change.
# (start.sh generates INGEST_API_KEY on first run if you leave it empty.)

# ── Model provider — any OpenAI-compatible chat endpoint with json_schema output ──
AI_BASE_URL=https://api.openai.com/v1
# ← SECRET: the provider key. The only value you must fill in.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Cheaper model for the sections strategy's identity and triage passes
AI_TRIAGE_MODEL=gpt-4.1-mini

# ── Service ─────────────────────────────────────────────────────────────────────
# Published on the host and used inside the container
INGEST_PORT=3002
# ← SECRET: callers send it as x-api-key or Authorization: Bearer. Empty = start.sh generates one.
INGEST_API_KEY=
# Paths are relative to the working directory: /app in the container (named volumes), this folder locally
INGEST_TYPES_DIR=./types
# Where confirmed / corrected examples from POST /v1/feedback are kept (loaded with the packs)
INGEST_FEEDBACK_DIR=./feedback
# type: "auto" picks a type only at or above this model confidence (0–1)
INGEST_AUTO_THRESHOLD=0.7
INGEST_CACHE_DIR=./.cache
INGEST_TESSDATA_DIR=./.tessdata
# Tesseract workers (0 = derived from CPU count)
OCR_WORKERS=2
# Extractions in flight per process, and how many may wait; beyond that: 503 busy (run more replicas behind a load balancer)
INGEST_CONCURRENCY=4
INGEST_MAX_QUEUE=32

# ── Extraction tuning ──────────────────────────────────────────────────────────
# 'fields' strategy: characters per model call
INGEST_WINDOW_CHARS=14000
# 'sections' strategy: characters per call when a document cannot be split into sections
CLAUSES_WINDOW_CHARS=90000
# 'sections' strategy: shorter texts skip triage (one extraction call)
TRIAGE_MIN_CHARS=40000
# 'sections' strategy: selected sections grouped up to this many characters per parallel call
EXTRACT_GROUP_CHARS=5000
# 'sections' strategy: principal sections per call (1 keeps every call short)
EXTRACT_GROUP_SECTIONS=1
# 'sections' strategy: parallel model calls
EXTRACT_CONCURRENCY=8
