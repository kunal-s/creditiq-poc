# CreditIQ document-processing sidecar. Copy to .env (git-ignored) or export.
CREDITIQ_DATA_ROOT=
INGEST_PORT=3102
# Loopback only unless INGEST_API_KEY is set.
INGEST_HOST=127.0.0.1
INGEST_API_KEY=
# stub | anthropic | gemini
INGEST_MODEL_PROVIDER=stub
# replay | record | live
INGEST_MODEL_MODE=replay
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OCR_WORKERS=2
