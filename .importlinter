[importlinter]
root_packages =
    engine

# Rule 4 (CLAUDE.md): configuration governs behaviour; nothing learns at
# runtime. The config writer performs an administrative publish and must be
# unreachable from anything that runs on a case: the config reader, and the
# pipeline, review and harness modules as their features land (add each new
# runtime package here). Only engine.cli, and engine.admin_config for the
# Administrator's publish from the Administration screen (F-00.4, reached from
# engine.api), may import the writer. Indirect imports count too, so nothing
# listed here may import engine.admin_config or engine.api.
[importlinter:contract:1]
name = Runtime code must not import the config writer
type = forbidden
source_modules =
    engine.approval
    engine.auth
    engine.bank_conduct
    engine.bank_txns
    engine.cam
    engine.cam_copilot
    engine.cam_review
    engine.cam_templates
    engine.cases
    engine.checklist
    engine.comparison
    engine.completeness
    engine.config
    engine.crosschecks
    engine.contracts
    engine.db
    engine.deps
    engine.exports
    engine.facts
    engine.filetypes
    engine.identifiers
    engine.ingest_client
    engine.jobs
    engine.keys
    engine.names
    engine.outbox
    engine.output_sources
    engine.pages
    engine.pd_note
    engine.parties
    engine.pipeline
    engine.policy
    engine.progress
    engine.proposal
    engine.queries
    engine.reads
    engine.reference
    engine.rejections
    engine.review
    engine.review_items
    engine.spread
    engine.reconcile
    engine.statement_edits
    engine.statements
    engine.workings
    engine.store
    engine.txn_intel
    engine.txn_labels
    engine.uploads
    engine.units
    engine.util
    engine.xlsx
    engine.xv
    engine.xv_cards
    engine.configstore.reader
forbidden_modules =
    engine.configstore.writer

# F-25.5: RBL's reference record and the reviewer's adjudications are for comparison only.
# Nothing that produces the appraisal may read them, so a decision on the comparison can
# never change the policy, the approving authority, the memo or the PD note.
[importlinter:contract:2]
name = Processing never reads RBL's reference record or adjudications (F-25.5)
type = forbidden
source_modules =
    engine.approval
    engine.cam
    engine.checklist
    engine.completeness
    engine.crosschecks
    engine.exports
    engine.facts
    engine.output_sources
    engine.pd_note
    engine.pipeline
    engine.policy
    engine.progress
    engine.review
    engine.spread
    engine.reconcile
    engine.statement_edits
    engine.statements
    engine.workings
    engine.xv
    engine.xv_cards
forbidden_modules =
    engine.comparison
    engine.reference
