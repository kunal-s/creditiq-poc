{
  "name": "@creditiq/ingest-engine",
  "version": "0.2.0",
  "description": "CreditIQ document-processing sidecar: page reading, quality grade, splitting, classification and field extraction against the published CreditIQ configuration.",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures": "tsx tests/fixtures/generate.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.14",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
