{
  "version": 1,
  "description": "A letter or e-mail from an auditor or regulator asking for things → the items requested, by when, and which controls or areas they concern.",
  "strategy": "fields",
  "instructions": "The document asks the organisation to provide information, evidence or access. List each requested item as one line, the due date if stated, who is asking, the engagement or reference number, and the controls, systems or areas the request concerns.",
  "fields": [
    {
      "name": "requester",
      "type": "string",
      "description": "Who is asking (person and organisation)",
      "required": true
    },
    {
      "name": "reference",
      "type": "string",
      "description": "Engagement / audit / inspection reference",
      "required": false
    },
    {
      "name": "requestedItems",
      "type": "string[]",
      "description": "Each item requested",
      "required": true
    },
    {
      "name": "dueDate",
      "type": "date",
      "description": "When it is due",
      "required": false
    },
    {
      "name": "areas",
      "type": "string[]",
      "description": "Controls, systems or topics concerned",
      "required": false
    }
  ],
  "signatures": {
    "textAny": [
      "\\bplease (provide|share|furnish)\\b",
      "\\bevidence request",
      "\\bwalkthrough\\b",
      "\\bsample of\\b"
    ],
    "textAll": [
      "\\baudit"
    ],
    "confidence": 0.8
  }
}
