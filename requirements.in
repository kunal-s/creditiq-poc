# Python dependencies for the engine.
# No AGPL/GPL/LGPL runtime deps: PyMuPDF, Ghostscript, OCRmyPDF, img2pdf,
# docxtpl and python-Levenshtein are excluded on licence grounds
# (CLAUDE.md rule 10). Add dependencies with the feature that needs them
# (docs/functional-requirements.md) and recompile requirements.txt.

# Service: sign-in, cases, published configuration, uploads (F-05).
fastapi
uvicorn[standard]
pydantic
pyyaml
python-multipart

# Page images for uploads and the evidence viewer (F-05.6, F-16).
# pypdfium2: Apache-2.0 or BSD-3-Clause (PDFium itself is BSD-3-Clause).
# Pillow: MIT-CMU (HPND). Both permissive (CLAUDE.md rule 10).
pypdfium2
pillow

# The draft CAM and PD note as downloads (F-23.5, F-24.3): Word and PDF.
# python-docx: MIT (lxml: BSD-3-Clause). reportlab: BSD (charset-normalizer: MIT,
# pillow above). All permissive (CLAUDE.md rule 10).
python-docx
reportlab

# Tooling: import contract and tests (httpx drives FastAPI's TestClient).
import-linter
pytest
httpx
