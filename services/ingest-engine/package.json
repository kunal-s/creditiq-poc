{
  "name": "@onegrc/ingest-engine",
  "version": "0.1.0",
  "description": "Turns any document — a URL, a file (PDF, DOCX, HTML, text, scanned image) or an e-mail — into the structured information a calling application asked for, driven by per-type profiles and caller-supplied rules.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@napi-rs/canvas": "^1.0.9",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "html-to-text": "^9.0.5",
    "mailparser": "^3.9.24",
    "mammoth": "^1.12.2",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
