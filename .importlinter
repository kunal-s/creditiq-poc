[importlinter]
root_packages =
    engine

# Rule 4 (CLAUDE.md): configuration governs behaviour; nothing learns at
# runtime. The config writer performs an administrative publish and must be
# unreachable from anything that runs on a case: the API, the config reader,
# and the pipeline, review and harness modules as their features land (add
# each new runtime package here). Only engine.cli may import the writer.
[importlinter:contract:1]
name = Runtime code must not import the config writer
type = forbidden
source_modules =
    engine.api
    engine.auth
    engine.cases
    engine.checklist
    engine.completeness
    engine.confidence
    engine.config
    engine.contracts
    engine.db
    engine.deps
    engine.facts
    engine.filetypes
    engine.identifiers
    engine.ingest_client
    engine.jobs
    engine.names
    engine.pages
    engine.parties
    engine.pipeline
    engine.progress
    engine.proposal
    engine.queries
    engine.reads
    engine.review
    engine.review_items
    engine.store
    engine.uploads
    engine.util
    engine.configstore.reader
forbidden_modules =
    engine.configstore.writer
